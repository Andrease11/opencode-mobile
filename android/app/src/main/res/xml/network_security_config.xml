<?xml version="1.0" encoding="utf-8"?>
<!-- OpenCode servers are self-hosted on a LAN or VPN and usually served over plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
