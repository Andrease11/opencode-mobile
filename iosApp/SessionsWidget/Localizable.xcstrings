    "widget_no_server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app to connect to a server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app per connetterti a un server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app para conectarte a un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'application pour vous connecter à un serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App, um eine Verbindung zu einem Server herzustellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app para conectar a um servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение, чтобы подключиться к серверу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用以连接服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続するにはアプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결하려면 앱을 여세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق للاتصال بخادم."
          }
        }
      }
    },
    "widget_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sessions yet. Tap New to start one."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sessione ancora. Tocca Nuova per iniziarne una."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay sesiones. Toca Nueva para iniciar una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune session pour l'instant. Appuyez sur Nouvelle pour en démarrer une."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Sitzungen. Tippe auf Neu, um eine zu starten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma sessão ainda. Toque em Nova para iniciar uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессий пока нет. Нажмите «Новый», чтобы начать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有会话。点按“新建”开始一个。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだセッションがありません。「新規」をタップして開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 세션이 없습니다. “새로”를 눌러 시작하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد جلسات بعد. اضغط «جديدة» لبدء جلسة."
          }
        }
      }
    },
