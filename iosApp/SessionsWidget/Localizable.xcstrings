    "widget_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running and recent sessions, and a button to start a new one."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessioni in esecuzione e recenti, e un pulsante per avviarne una nuova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones en ejecución y recientes, y un botón para iniciar una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions en cours et récentes, et un bouton pour en démarrer une nouvelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende und letzte Sitzungen sowie eine Schaltfläche, um eine neue zu starten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões em execução e recentes, e um botão para iniciar uma nova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущенные и недавние сеансы, а также кнопка для запуска нового."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行和最近的会话，以及一个用于新建会话的按钮。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中および最近のセッションと、新しいセッションを開始するボタン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 세션과 최근 세션, 그리고 새 세션을 시작하는 버튼."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسات الجارية والأخيرة، وزر لبدء جلسة جديدة."
          }
        }
      }
    },
